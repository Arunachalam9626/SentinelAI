@model SentinelAI.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow-lg">
                <div class="card-header bg-danger text-white d-flex align-items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation fa-lg"></i>
                    <h4 class="mb-0">Application Error</h4>
                </div>
                <div class="card-body py-5 text-center">
                    <i class="fa-solid fa-triangle-exclamation fa-4x text-danger mb-4"></i>
                    <h2 class="text-danger mb-3">Something went wrong.</h2>
                    <p class="text-muted mb-4">An unexpected error occurred. Please try again or contact your system administrator.</p>
                    @if (Model.ShowRequestId)
                    {
                        <div class="alert alert-secondary">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </div>
                    }
                    <a href="/" class="btn btn-primary me-2">
                        <i class="fa-solid fa-house me-1"></i>Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
