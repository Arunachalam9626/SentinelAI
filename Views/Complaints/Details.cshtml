@model SentinelAI.Models.Complaint
@{
    ViewData["Title"] = "Incident Details";
    Layout = "_Layout";
    bool isHighRisk = Model.RiskLevel == "High" || Model.RiskLevel == "Critical";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-magnifying-glass me-2 text-warning"></i>Incident Details</h1>
                <p>Report #@Model.Id — Submitted @Model.CreatedDate.ToString("dd MMMM yyyy, HH:mm") UTC</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light">
                <i class="fa-solid fa-arrow-left me-1"></i>Back to My Reports
            </a>
        </div>
    </div>
</div>

<div class="container mb-5">
    @if (isHighRisk)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-3 mb-4" role="alert">
            <i class="fa-solid fa-radiation fa-xl mt-1 flex-shrink-0"></i>
            <div>
                <h5 class="alert-heading mb-1">⚠️ @Model.RiskLevel Risk Alert — Immediate Action Required</h5>
                <p class="mb-0">
                    This incident has been classified as <strong>@Model.RiskLevel risk</strong>.
                    @if (Model.RiskLevel == "Critical")
                    {
                        <span>Contact your Commanding Officer and CERT team <strong>immediately</strong>. Do not delay response.</span>
                    }
                    else
                    {
                        <span>Report to your unit CERT as soon as possible and follow mitigation steps below.</span>
                    }
                </p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Details -->
        <div class="col-lg-8">
            <div class="content-box mb-4">
                <h5><i class="fa-solid fa-info-circle me-2"></i>Incident Information</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="mb-1 text-muted small fw-semibold">TITLE</div>
                        <div class="fs-5 fw-bold">@Model.Title</div>
                    </div>
                    <div class="col-12">
                        <div class="mb-1 text-muted small fw-semibold">DESCRIPTION</div>
                        <div class="p-3 bg-light rounded-3" style="white-space: pre-wrap;">@Model.Description</div>
                    </div>
                </div>
            </div>

            <div class="content-box mb-4">
                <h5><i class="fa-solid fa-robot me-2 text-primary"></i>AI Analysis Results</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 border">
                            <div class="text-muted small fw-semibold mb-1">INCIDENT TYPE</div>
                            <span class="badge bg-secondary fs-6">@Model.IncidentType</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 border @(Model.RiskLevel == "Critical" ? "border-danger bg-danger-subtle" : Model.RiskLevel == "High" ? "bg-warning-subtle" : "")">
                            <div class="text-muted small fw-semibold mb-1">RISK LEVEL</div>
                            @{
                                var riskClass = Model.RiskLevel switch
                                {
                                    "Critical" => "badge-risk-critical",
                                    "High" => "badge-risk-high",
                                    "Medium" => "badge-risk-medium",
                                    _ => "badge-risk-low"
                                };
                            }
                            <span class="badge @riskClass fs-6">@Model.RiskLevel</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="content-box">
                <h5><i class="fa-solid fa-shield-virus me-2 text-success"></i>Mitigation Steps</h5>
                <div class="alert alert-success mb-0">
                    <i class="fa-solid fa-list-check me-2"></i>
                    @Model.MitigationSteps
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="content-box mb-4">
                <h5><i class="fa-solid fa-circle-dot me-2"></i>Status & Meta</h5>
                <dl class="mb-0">
                    <dt class="text-muted small fw-semibold">STATUS</dt>
                    <dd class="mb-3">
                        @{
                            var statusClass = Model.Status switch
                            {
                                "Pending" => "badge-status-pending",
                                "Investigating" => "badge-status-investigating",
                                _ => "badge-status-resolved"
                            };
                        }
                        <span class="badge @statusClass fs-6">@Model.Status</span>
                    </dd>
                    <dt class="text-muted small fw-semibold">REPORTED DATE</dt>
                    <dd class="mb-3">@Model.CreatedDate.ToString("dd MMM yyyy, HH:mm") UTC</dd>
                    <dt class="text-muted small fw-semibold">REPORT ID</dt>
                    <dd class="mb-0"><code>#@Model.Id</code></dd>
                </dl>
            </div>

            @if (!string.IsNullOrEmpty(Model.EvidencePath))
            {
                <div class="content-box mb-4">
                    <h5><i class="fa-solid fa-paperclip me-2"></i>Evidence File</h5>
                    @{
                        var ext = System.IO.Path.GetExtension(Model.EvidencePath).ToLowerInvariant();
                        var isImage = ext == ".jpg" || ext == ".jpeg" || ext == ".png";
                    }
                    @if (isImage)
                    {
                        <img src="@Model.EvidencePath" alt="Evidence" class="img-fluid rounded-3 mb-2" />
                    }
                    else
                    {
                        <div class="alert alert-secondary py-2">
                            <i class="fa-solid fa-file-pdf text-danger me-2"></i>
                            PDF Document attached
                        </div>
                    }
                    <a href="@Model.EvidencePath" target="_blank" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="fa-solid fa-download me-1"></i>Download Evidence
                    </a>
                </div>
            }

            <div class="content-box">
                <h5><i class="fa-solid fa-tools me-2"></i>Actions</h5>
                <div class="d-grid gap-2">
                    <a asp-action="Index" class="btn btn-outline-primary">
                        <i class="fa-solid fa-list me-1"></i>All My Reports
                    </a>
                    <a asp-action="Create" class="btn btn-warning">
                        <i class="fa-solid fa-plus me-1"></i>New Incident
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fa-solid fa-trash me-1"></i>Delete Report
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
