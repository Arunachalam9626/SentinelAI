@model IEnumerable<SentinelAI.Models.Complaint>
@{
    ViewData["Title"] = "My Incidents";
    Layout = "_Layout";
}

<div class="page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-list me-2 text-warning"></i>My Incident Reports</h1>
                <p>Track all your submitted cyber incident reports</p>
            </div>
            <a asp-action="Create" class="btn btn-warning fw-bold">
                <i class="fa-solid fa-plus me-1"></i>Report New Incident
            </a>
        </div>
    </div>
</div>

<div class="container mb-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-inbox fa-4x text-muted mb-4"></i>
            <h4 class="text-muted">No incidents reported yet</h4>
            <p class="text-muted mb-4">You haven't reported any cyber incidents. Stay vigilant and report suspicious activity immediately.</p>
            <a asp-action="Create" class="btn btn-warning btn-lg">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>Report Your First Incident
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive rounded-3 shadow-sm">
            <table class="table table-hover mb-0 table-sentinel">
                <thead>
                    <tr>
                        <th><i class="fa-solid fa-hashtag me-1"></i>ID</th>
                        <th><i class="fa-solid fa-heading me-1"></i>Title</th>
                        <th><i class="fa-solid fa-tag me-1"></i>Type</th>
                        <th><i class="fa-solid fa-shield me-1"></i>Risk Level</th>
                        <th><i class="fa-solid fa-circle-dot me-1"></i>Status</th>
                        <th><i class="fa-solid fa-calendar me-1"></i>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@item.Id</td>
                            <td>
                                <span class="fw-semibold">@item.Title</span>
                                @if (!string.IsNullOrEmpty(item.EvidencePath))
                                {
                                    <i class="fa-solid fa-paperclip text-muted ms-1" title="Has attachment"></i>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.IncidentType</span>
                            </td>
                            <td>
                                @{
                                    var riskClass = item.RiskLevel switch
                                    {
                                        "Critical" => "badge-risk-critical",
                                        "High" => "badge-risk-high",
                                        "Medium" => "badge-risk-medium",
                                        _ => "badge-risk-low"
                                    };
                                }
                                <span class="badge @riskClass">@item.RiskLevel</span>
                            </td>
                            <td>
                                @{
                                    var statusClass = item.Status switch
                                    {
                                        "Pending" => "badge-status-pending",
                                        "Investigating" => "badge-status-investigating",
                                        _ => "badge-status-resolved"
                                    };
                                }
                                <span class="badge @statusClass">@item.Status</span>
                            </td>
                            <td class="text-muted small">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted mt-3 small">
            <i class="fa-solid fa-circle-info me-1"></i>
            Showing @Model.Count() incident(s). Contact CERT for urgent threats.
        </p>
    }
</div>
